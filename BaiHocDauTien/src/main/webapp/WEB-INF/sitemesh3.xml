<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <!-- Thiết lập dispatch-mode là include để tương thích với Tomcat 11 -->
    <dispatch-mode>include</dispatch-mode>
    <decorator-prefix></decorator-prefix>
    <mime-type>text/html</mime-type>
    <mime-type>application/xhtml+xml</mime-type>

    <!-- Loại trừ tài nguyên tĩnh, ảnh và template con -->
    <mapping path="/images/*" exclude="true" />
    <mapping path="/assets/*" exclude="true" />
    <mapping path="/image" exclude="true" />
    <mapping path="/image/*" exclude="true" />
    <mapping path="/css/*" exclude="true" />
    <mapping path="/js/*" exclude="true" />
    <mapping path="/decorators/*" exclude="true" />
    <mapping path="/common/*" exclude="true" />

    <!-- Quản lý giao diện Admin -->
    <mapping path="/admin/*" decorator="/decorators/admin.jsp" />
    <mapping path="/admin" decorator="/decorators/admin.jsp" />

    <!-- Quản lý giao diện Người dùng / Public chung -->
    <mapping path="/*" decorator="/decorators/web.jsp" />
</sitemesh>
